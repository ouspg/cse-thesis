% testphase-toc: \numberline is registered in the LaTeX3 text module as
% \use_none:n (strips the number) inside a \group_begin:/\group_end: block so
% that \text_purify:n can build a plain-text tag title without the number.
% Because \tl_set:cn is LOCAL, the registration reverts after each group ends.
% We declare \numberline unexpanded HERE (load time = effectively global) so
% \MakeUppercase in contentsline@text@0@format preserves the number token,
% which the typesetting \renewcommand below then renders as "N. ".
% IMPORTANT: must be at load level with ExplSyntaxOn active, NOT inside
% \AtBeginDocument{...} where the argument is tokenized at read time.
\ExplSyntaxOn
\text_declare_expand_equivalent:Nn \numberline { \exp_not:n { \numberline } }
\ExplSyntaxOff

\AtBeginDocument{%
  \makeatletter
  \renewcommand{\numberline}[1]{#1\sectionnamedot\enspace}%
  % tocloft's \l@chapter uses {\cftchapfont #1} — it does not call
  % contentsline@text@0@format. Wrap \l@chapter to uppercase before
  % passing to tocloft. \text_declare_expand_equivalent above ensures
  % \MakeUppercase preserves \numberline so the number survives.
  \let\oldl@chapter\l@chapter
  \renewcommand*\l@chapter[2]{\oldl@chapter{\MakeUppercase{#1}}{#2}}%
  \makeatother
}

