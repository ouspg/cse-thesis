% Headings. Spacing follows the Typography section of the guide: 2 empty rows
% before a heading, 1 after, and 1 between two headings; the chapter heading
% sits on the top margin and the first paragraph after a heading is not
% indented. titlesec is not used: it replaces the kernel sectioning code that
% latex-lab hooks for tagging, so its section titles were tagged as P, not H2.
%
% The layout is declared as latex-lab `heading' template instances, which the
% kernel uses from 2026-06. The template adds no space before a heading that
% directly follows another, which gives the 1 empty row between headings.
% Older kernels get an equivalent \@startsection implementation from
% dithesis-compat.sty, which also decides which of the two runs
% (\dithesis@setupheadings, at \begin{document}, as latex-lab's class/after
% hook would otherwise overwrite the definitions).
\newcommand*\dithesis@headinginstances{%
  % Chapter: 14pt bold, centered, uppercase. On the top margin, 1 empty row after.
  \DeclareInstance{heading}{chapter}{display}{%
    , name                 = chapter
    , level                = 0
    , placement            = top
    , after-penalty-vspace = 0pt
    , after-vspace         = \baselineskip
    , number-format        = \theheading\sectionnamedot
    , heading-decls        = \normalfont\bfseries\fontsize{14}{17}\selectfont\centering
    , headformat-instance  = chapter
    , mark-cmd             = \chaptermark{##1}
    , contents-extra       = \addtocontents{lof}{\protect\addvspace{10\p@}}%
                             \addtocontents{lot}{\protect\addvspace{10\p@}}%
  }%
  \DeclareInstance{headformat}{chapter}{hang}{%
    , number-title-sep = 1em
    , title-format     = \MakeUppercase{##1}
  }%
  % Section: 12pt bold, centered. 2 empty rows before and 1 after.
  \DeclareInstance{heading}{section}{display}{%
    , name                = section
    , level               = 1
    , before-vspace       = 2\baselineskip
    , after-vspace        = \baselineskip
    , number-format       = \theheading\sectionnamedot
    , heading-decls       = \normalfont\bfseries\fontsize{12}{15}\selectfont\centering
    , headformat-instance = section
    , mark-cmd            = \sectionmark{##1}
  }%
  % Subsection: bold italic, centered. 2 empty rows before and 1 after.
  \DeclareInstance{heading}{subsection}{display}{%
    , name                = subsection
    , parent-name         = section
    , level               = 2
    , before-vspace       = 2\baselineskip
    , after-vspace        = \baselineskip
    , number-format       = \theheading\sectionnamedot
    , heading-decls       = \normalfont\bfseries\itshape\centering
    , headformat-instance = subsection
    , mark-cmd            = \subsectionmark{##1}
  }%
  % Subsubsection: italic, centered. 2 empty rows before and 1 after.
  \DeclareInstance{heading}{subsubsection}{display}{%
    , name                = subsubsection
    , parent-name         = subsection
    , level               = 3
    , before-vspace       = 2\baselineskip
    , after-vspace        = \baselineskip
    , number-format       = \theheading\sectionnamedot
    , heading-decls       = \normalfont\itshape\centering
    , headformat-instance = subsubsection
  }%
}
\AtBeginDocument{\dithesis@setupheadings}

